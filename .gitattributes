# Spotless runs palantir-java-format over the sources and wants LF, so the working tree
# has to hold LF whatever the checkout platform would otherwise do. Without this the
# build fails on Windows the moment git hands the files back with CRLF, and every commit
# carries a warning about it.
* text=auto eol=lf

# Binary, and must never be touched.
*.png binary
*.ogg binary
*.jar binary
