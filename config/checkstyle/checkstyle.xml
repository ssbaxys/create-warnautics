<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Correctness only. Layout belongs to Spotless, which runs palantir-java-format over the
  same sources; a checkstyle that also had opinions about braces and wrapping would spend
  its life disagreeing with the formatter that had just finished writing the file.

  What is left is the small set of things a formatter cannot see: imports that are not
  used, an equals with no hashCode beside it, a block that silently swallows something.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <!-- Imports the compiler is happy with and a reader is not. -->
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="RedundantImport"/>

        <!-- Pairs that are only correct together. -->
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>

        <!-- Silent mistakes. -->
        <module name="EmptyStatement"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="MissingSwitchDefault"/>

        <!-- A modifier order the language already fixed for us. -->
        <module name="ModifierOrder"/>
        <module name="UpperEll"/>
    </module>
</module>
